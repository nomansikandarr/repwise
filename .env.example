# Copy to .env.local. Never commit .env.local.
# Server-only secrets must NOT be prefixed with NEXT_PUBLIC_.

# --- Neon (filled in automatically) -------------------------------------
# `neon deploy` (or `neon env pull`) writes these into .env.local:
#   DATABASE_URL, DATABASE_URL_UNPOOLED, NEON_BRANCH, NEON_BRANCH_ID,
#   NEON_AUTH_BASE_URL, NEON_AUTH_JWKS_URL,
#   NEON_REALTIME_URL, NEON_REALTIME_SECRET,
#   AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_ENDPOINT_URL_S3, AWS_REGION,
#   NEON_AI_GATEWAY_TOKEN, NEON_AI_GATEWAY_BASE_URL, NEON_FUNCTION_HOST_SUFFIX

# --- App config (add by hand) --------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# 32+ random chars, signs cached session cookies. Not provided by Neon.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEON_AUTH_COOKIE_SECRET=
# This email becomes admin the first time it signs in (seed uses it too).
ADMIN_EMAIL=admin@repwise.test

# --- Sentry --------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
# Only needed for uploading source maps at build time (Vercel env):
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Stream (phases 5–6) -------------------------------------------------
NEXT_PUBLIC_STREAM_API_KEY=
STREAM_API_SECRET=

# --- ImageKit (phase 4) --------------------------------------------------
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
